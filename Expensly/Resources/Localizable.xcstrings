        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern"
          }
        }
      }
    },
    "Share a folder in iCloud Drive with your family in the Files app, then choose that folder here on each iPhone. Expensly syncs when it opens and when you tap Sync Now. Budgets are matched by name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile einen Ordner in iCloud Drive über die Dateien-App mit deiner Familie und wähle diesen Ordner hier auf jedem iPhone. Expensly synchronisiert beim Öffnen und bei „Jetzt synchronisieren“. Budgets werden über ihren Namen zugeordnet."
          }
        }
      }
    },
    "Share the expenses of the shown period as a tab-separated text file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile die Ausgaben des angezeigten Zeitraums als Textdatei (Tab-getrennt)."
          }
        }
      }
    },
