    "Share the expenses of the shown period as a tab-separated text file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile die Ausgaben des angezeigten Zeitraums als Textdatei (Tab-getrennt)."
