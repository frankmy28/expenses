        }
      }
    },
    "Tap + to record a new expense. Tap an expense to edit it, swipe it to delete it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf +, um eine Ausgabe zu erfassen. Tippe auf eine Ausgabe zum Bearbeiten, wische zum Löschen."
          }
        }
      }
    },
    "Tap a place on the map": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Ort in der Karte"
          }
        }
      }
    },
    "Tap the date to show a week, month, year or all expenses. Use the arrows or swipe the bar to move back and forward in time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Datum, um Woche, Monat, Jahr oder alle Ausgaben zu zeigen. Mit den Pfeilen oder durch Wischen über die Leiste springst du vor und zurück."
          }
        }
      }
    },
